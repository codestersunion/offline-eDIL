<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @page_title ? "#{h @page_title} · " : '' %>Dictionary of the Irish Language</title>
  <link rel="stylesheet" href="/css/bootstrap.css">
  <link rel="stylesheet" href="/css/bootstrap-responsive.css">
  <link rel="stylesheet" href="/css/edil.css">
  <link rel="stylesheet" href="/css/entry.css">
  <link rel="shortcut icon" href="/favicon.ico">
</head>
<body>
  <header>
    <div class="navbar navbar-fixed-top">
      <div class="navbar-inner">
        <div class="container">
          <a class="btn btn-navbar" data-toggle="collapse" data-target=".nav-collapse">
            <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
          </a>
          <a class="brand" href="/">Dictionary of the Irish Language</a>
          <div class="nav-collapse">
            <ul class="nav">
              <li><a href="/about">About</a></li>
              <li><a href="/entries">Headwords</a></li>
              <li><a href="/columns">Browse</a></li>
              <li><a href="/bibliography">Bibliography</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
            <form action="/search" method="get" class="navbar-search pull-right">
              <input type="text" name="q" class="search-query typeahead" placeholder="Search" autocomplete="off" value="<%= h @query %>">
            </form>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div id="site" class="container">
    <%= yield %>
  </div>

  <footer class="container">
    <p>Copyright &copy; 2012 Queen's University, Belfast. All Rights Reserved.</p>
  </footer>

  <script src="/js/jquery.min.js"></script>
  <script src="/js/bootstrap.js"></script>
  <script src="/js/edil.js"></script>
</body>
</html>
