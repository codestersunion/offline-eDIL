<% @page_title = 'Search' %>
<h1>Search</h1>
<form action="/search" method="get" class="form-search">
  <input type="text" name="q" class="input-xlarge search-query" value="<%= h @query %>" autofocus>
  <label class="radio inline"><input type="radio" name="in" value="headwords"<%= ' checked' if @in == 'headwords' %>> Headwords</label>
  <label class="radio inline"><input type="radio" name="in" value="definitions"<%= ' checked' if @in == 'definitions' %>> Definitions</label>
  <button type="submit" class="btn">Search</button>
</form>

<% unless @query.empty? %>
  <p><%= @results.size %><%= '+' if @results.size == 200 %> <%= @results.size == 1 ? 'result' : 'results' %> for <strong><%= h @query %></strong> in <%= @in %>.</p>
  <ul class="results">
    <% @results.each do |e| %>
      <li>
        <a href="<%= entry_path(e) %>"><%= h e.label %></a>
        <% unless e.definitions.empty? %><span class="muted">— <%= h e.definitions.first(3).join('; ') %></span><% end %>
      </li>
    <% end %>
  </ul>
<% end %>
